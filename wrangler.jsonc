// Cloudflare Workers config: a static-assets-only Worker (no server code).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinochle-score",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // The app uses #/ hash routes, so unknown paths can simply 404.
    "not_found_handling": "none",
  },
  // Custom domain: add "pinochle.theavey.com" in the Cloudflare dashboard
  // (Workers & Pages → pinochle-score → Settings → Domains & Routes), or
  // uncomment once the theavey.com zone is on this account:
  // "routes": [{ "pattern": "pinochle.theavey.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": false },
}
