{
  "name": "pinochle-score-webapp",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first score keeper for 4-player partnership pinochle",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "types:worker": "wrangler types"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
